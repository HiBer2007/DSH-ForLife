/**
 * admin-ui 的 tsconfig —— **独立于根 tsconfig**。
 *
 * 为什么必须独立：
 *  - 根 tsconfig 是给 Node 侧代码用的（`module: NodeNext`、`lib: ["ES2023"]`、无 DOM），
 *    前端代码需要 `DOM` 与 `ESNext` 的 bundler 解析；
 *  - 根 tsconfig 的 include 覆盖 `packages/*/src/**/*.ts`，所以根配置里把本包**排除**，
 *    两边各管各的，`pnpm typecheck` 不会因为前端代码而失败。
 */
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
