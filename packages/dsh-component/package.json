{
  "name": "forlife-memory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DSH-ForLife 便携组件：长期记忆 + QQ 生命体运行时（双入口：dsh-std facet + legacy cordis）",
  "exports": {
    ".": "./src/index.ts",
    "./facet": "./src/facet.ts",
    "./config": "./src/config.ts",
    "./runtime": "./src/runtime.ts",
    "./client": "./client/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./dsh-plugin.json": "./dsh-plugin.json",
    "./package.json": "./package.json",
    "./panel": "./src/panel-plugin.ts",
    "./compaction": "./src/compaction-engine.ts"
  },
  "files": [
    "src",
    "client",
    "dsh-plugin.json",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "@forlife/contracts": "workspace:*",
    "@forlife/store": "workspace:*",
    "@forlife/memory-core": "workspace:*",
    "@forlife/gateway": "workspace:*"
  }
}
