{
  "name": "dsh-forlife",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "doctor": "node scripts/doctor.ts",
    "test": "node --test --experimental-test-isolation=none \"packages/**/test/*.test.ts\" \"tests/*.test.ts\"",
    "fidelity": "node --test packages/contracts/test/fidelity.test.ts",
    "profile:dump": "node scripts/profile-dump.ts",
    "dev:up": "pwsh -File scripts/dev-up.ps1",
    "typecheck": "tsc -p tsconfig.json",
    "lint:prompt": "node scripts/lint-prompt-positions.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
